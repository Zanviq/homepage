# ─────────────────────────────────────────────────────────────
#  zanviq-homepage — environment configuration
#  Copy this file to `.env` and fill in the real values.
#  `.env` is git-ignored and must NEVER be committed.
# ─────────────────────────────────────────────────────────────

# ── Cloudflare Tunnel ────────────────────────────────────────
# Token from the Cloudflare Zero Trust dashboard (remotely-managed tunnel).
# Route zanviq.dev -> http://frontend:3000 in the dashboard.
TUNNEL_TOKEN=your-cloudflare-tunnel-token-here

# ── Admin login (the only account that can edit the site) ────
# Reachable only by manually visiting https://zanviq.dev/login
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-a-strong-password

# ── Auth secret ──────────────────────────────────────────────
# Used to sign the session JWT. Generate a long random string:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace-with-a-long-random-secret

# ── Gemini API (KO → EN auto-translation in the editor) ──────
# Get a key at https://aistudio.google.com/apikey
# Leave blank to disable the translate button.
GEMINI_API_KEY=
# Optional: override the model (default: gemini-2.0-flash)
# GEMINI_MODEL=gemini-2.0-flash

# ── Data directory (inside the backend container) ────────────
# Bind-mounted from the Raspberry Pi HDD in docker-compose.yml:
#   /mnt/hdd/homepage  ->  /data
DATA_DIR=/data
